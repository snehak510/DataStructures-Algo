Wise 2 - Tik tok toe

private boolean checkWin(
        char[][] board,
        int row,
        int col,
        char player,
        int winCount) {

    int[][] dirs = {
        {0, 1},
        {1, 0},
        {1, 1},
        {1, -1}
    };

    for (int[] d : dirs) {

        int count = 1;

        int r = row + d[0];
        int c = col + d[1];

        while (r >= 0 && r < board.length &&
               c >= 0 && c < board.length &&
               board[r][c] == player) {

            count++;

            if (count >= winCount)
                return true;

            r += d[0];
            c += d[1];
        }
    }

    return false;
}